{
  "name": "test/new-app",
  "description": "hello",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.1.0",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "dbout/wp-orm": "3.2.0",
    "doctrine/annotations": "1.14.3",
    "illuminate/pagination": "10.48.12",
    "phpdocumentor/reflection-docblock": "5.4.1",
    "phpoffice/phpspreadsheet": "1.29.0",
    "symfony/console": "5.4.40",
    "symfony/dotenv": "5.4.40",
    "symfony/flex": "1.21.6",
    "symfony/form": "6.0.19",
    "symfony/framework-bundle": "6.0.19",
    "symfony/http-client": "6.0.20",
    "symfony/mime": "6.0.19",
    "symfony/monolog-bundle": "3.10.0",
    "symfony/property-access": "6.0.19",
    "symfony/property-info": "6.0.19",
    "symfony/proxy-manager-bridge": "6.0.19",
    "symfony/runtime": "6.0.*",
    "symfony/security-csrf": "6.0.19",
    "symfony/serializer": "6.0.14",
    "symfony/twig-bundle": "6.0.19",
    "symfony/uid": "6.0.19",
    "symfony/webpack-encore-bundle": "1.17.2",
    "symfony/yaml": "6.0.19",
    "twig/extra-bundle": "3.8.0",
    "twig/twig": "3.10.3"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true,
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "platform": {
      "php": "8.1.0"
    }
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php74": "*"
  },
  "scripts": {
    "auto-scripts": {
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "cache:clear": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "6.0.*"
    }
  },
  "require-dev": {
    "symfony/maker-bundle": "1.50.0"
  }
}
